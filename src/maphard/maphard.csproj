<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>maphard</AssemblyName>
    <RootNamespace>MapHard</RootNamespace>
    <Description>MapHard - MT: o hardware deste computador.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>recursos\maphard.ico</ApplicationIcon>

    <!-- Entrega: um .exe unico, autocontido, para Windows 64 bits -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- Fonte, logo da MT e logo e icone do MapHard embutidos no .exe e lidos pela tela com pack:// -->
  <ItemGroup>
    <Resource Include="recursos\mt-logo.png" />
    <Resource Include="recursos\maphard-logo.png" />
    <Resource Include="recursos\maphard.ico" />
    <Resource Include="recursos\fontes\*.ttf" />
    <Resource Include="recursos\fontes\ofl.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\maphard.nucleo\maphard.nucleo.csproj" />
  </ItemGroup>

</Project>
