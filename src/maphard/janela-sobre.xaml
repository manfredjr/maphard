<Window x:Class="MapHard.JanelaSobre"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sobre="clr-namespace:MapHard.Nucleo.Sobre;assembly=maphard.nucleo"
        Style="{StaticResource JanelaMT}"
        Title="Sobre o MapHard - MT" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <DockPanel>
        <!-- Faixa do topo com o nome e a versao -->
        <Border DockPanel.Dock="Top" Background="{StaticResource GradienteFaixa}" Padding="18,12">
            <TextBlock x:Name="TextoTitulo" Foreground="White" FontSize="18" FontWeight="ExtraBold" />
        </Border>
        <Border DockPanel.Dock="Top" Height="3" Background="{StaticResource GradienteLinha}" />

        <!-- Rodape: marca da MT e botoes -->
        <DockPanel DockPanel.Dock="Bottom" Margin="18,0,18,14">
            <Button DockPanel.Dock="Left" Style="{StaticResource BotaoMarca}" Click="AoClicarMarcaMt"
                    AutomationProperties.Name="MT - Manfred Tecnologia"
                    ToolTip="MT - Manfred Tecnologia: abre o site www.manfred.com.br no navegador">
                <Image Source="pack://application:,,,/maphard;component/recursos/mt-logo.png"
                       Height="56" RenderOptions.BitmapScalingMode="HighQuality" />
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BotaoLicenca" Content="Ver a licença" Style="{StaticResource BotaoContorno}" Click="AoVerLicenca" />
                <Button Content="Fechar" Style="{StaticResource BotaoContorno}" Click="AoFechar" IsCancel="True" IsDefault="True" />
            </StackPanel>
        </DockPanel>

        <Border Style="{StaticResource Cartao}" Margin="18,14,18,14">
            <StackPanel>
                <TextBlock Text="{x:Static sobre:TextosSobre.Descricao}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{x:Static sobre:TextosSobre.Autoria}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="{x:Static sobre:TextosSobre.Copyright}" TextWrapping="Wrap" Margin="0,4,0,0" />

                <StackPanel Orientation="Horizontal" Margin="0,14,0,6">
                    <Border Style="{StaticResource BarraTitulo}" />
                    <TextBlock Text="Software livre" Style="{StaticResource TituloCartao}" />
                </StackPanel>
                <TextBlock Text="{x:Static sobre:TextosSobre.SoftwareLivre}" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Margin="0,14,0,6">
                    <Border Style="{StaticResource BarraTitulo}" />
                    <TextBlock Text="Onde baixar" Style="{StaticResource TituloCartao}" />
                </StackPanel>
                <TextBlock TextWrapping="Wrap">
                    <Run Text="Versões para baixar: " />
                    <Hyperlink Tag="{x:Static sobre:TextosSobre.Versoes}" Click="AoAbrirLink" Foreground="{StaticResource PincelVerde}">
                        <Run Text="{x:Static sobre:TextosSobre.Versoes}" />
                    </Hyperlink>
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                    <Run Text="Código: " />
                    <Hyperlink Tag="{x:Static sobre:TextosSobre.Repositorio}" Click="AoAbrirLink" Foreground="{StaticResource PincelVerde}">
                        <Run Text="{x:Static sobre:TextosSobre.Repositorio}" />
                    </Hyperlink>
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                    <Run Text="Site da MT: " />
                    <Hyperlink Tag="{x:Static sobre:TextosSobre.SiteMt}" Click="AoAbrirLink" Foreground="{StaticResource PincelVerde}">
                        <Run Text="{x:Static sobre:TextosSobre.SiteMt}" />
                    </Hyperlink>
                </TextBlock>

                <TextBlock Text="{x:Static sobre:TextosSobre.Fonte}" Foreground="{StaticResource PincelTextoSuave}"
                           TextWrapping="Wrap" Margin="0,14,0,0" />

                <!-- Texto completo da GPL-3.0, embutido no programa. Aparece pelo botao "Ver a licenca" -->
                <TextBox x:Name="CampoLicenca" Visibility="Collapsed" IsReadOnly="True" Height="300" Margin="0,12,0,0"
                         FontFamily="{StaticResource FonteConsole}" FontSize="11.5" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Texto da licença GPL-3.0" />
            </StackPanel>
        </Border>
    </DockPanel>
</Window>
