<!--
    Tema da MT para a tela do MapHard, igual ao site manfred.com.br e ao manual da marca:
    verdes #006B2D, #0F8F2F, #43A92C e #9AD52B, grafite #202020, cinza-claro #F4F4F4,
    fonte Montserrat, botoes em pilula e cartoes com borda arredondada.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cores oficiais -->
    <Color x:Key="CorVerdeEscuro">#006B2D</Color>
    <Color x:Key="CorVerde">#0F8F2F</Color>
    <Color x:Key="CorVerdeMedio">#43A92C</Color>
    <Color x:Key="CorVerdeClaro">#9AD52B</Color>
    <Color x:Key="CorGrafite">#202020</Color>
    <Color x:Key="CorCinzaClaro">#F4F4F4</Color>

    <SolidColorBrush x:Key="PincelVerdeEscuro" Color="{StaticResource CorVerdeEscuro}" />
    <SolidColorBrush x:Key="PincelVerde" Color="{StaticResource CorVerde}" />
    <SolidColorBrush x:Key="PincelVerdeMedio" Color="{StaticResource CorVerdeMedio}" />
    <SolidColorBrush x:Key="PincelVerdeClaro" Color="{StaticResource CorVerdeClaro}" />
    <SolidColorBrush x:Key="PincelGrafite" Color="{StaticResource CorGrafite}" />
    <SolidColorBrush x:Key="PincelCinzaClaro" Color="{StaticResource CorCinzaClaro}" />
    <SolidColorBrush x:Key="PincelTexto" Color="#202020" />
    <SolidColorBrush x:Key="PincelTextoSuave" Color="#6B6B6B" />
    <SolidColorBrush x:Key="PincelBorda" Color="#E3E3E3" />
    <SolidColorBrush x:Key="PincelTextoConsole" Color="#CFE9B8" />
    <SolidColorBrush x:Key="PincelVerdeFundo" Color="#E8F5DC" />

    <!-- Gradiente da marca: faixa do topo -->
    <LinearGradientBrush x:Key="GradienteFaixa" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="{StaticResource CorVerdeEscuro}" />
        <GradientStop Offset="1" Color="{StaticResource CorVerde}" />
    </LinearGradientBrush>

    <!-- Gradiente da marca: linha fina acima da barra de estado -->
    <LinearGradientBrush x:Key="GradienteLinha" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="{StaticResource CorVerdeEscuro}" />
        <GradientStop Offset="0.5" Color="{StaticResource CorVerdeMedio}" />
        <GradientStop Offset="1" Color="{StaticResource CorVerdeClaro}" />
    </LinearGradientBrush>

    <!-- Fonte Montserrat embutida no .exe (licenca SIL OFL 1.1 em recursos/fontes/ofl.txt) -->
    <FontFamily x:Key="FonteMT">pack://application:,,,/maphard;component/recursos/fontes/#Montserrat</FontFamily>
    <FontFamily x:Key="FonteConsole">Consolas, Courier New</FontFamily>

    <Style TargetType="{x:Type Window}" x:Key="JanelaMT">
        <Setter Property="FontFamily" Value="{StaticResource FonteMT}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource PincelTexto}" />
        <Setter Property="Background" Value="{StaticResource PincelCinzaClaro}" />
    </Style>

    <!-- Cartao branco com borda arredondada -->
    <Style TargetType="{x:Type Border}" x:Key="Cartao">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource PincelBorda}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <!-- Titulo de cartao com a barrinha verde na frente -->
    <Style TargetType="{x:Type TextBlock}" x:Key="TituloCartao">
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="{x:Type Border}" x:Key="BarraTitulo">
        <Setter Property="Width" Value="4" />
        <Setter Property="Height" Value="15" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="{StaticResource PincelVerdeMedio}" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Botao em pilula, base de todos os outros -->
    <Style TargetType="{x:Type Button}" x:Key="BotaoPilula">
        <Setter Property="FontFamily" Value="{StaticResource FonteMT}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource PincelVerde}" />
        <Setter Property="BorderBrush" Value="White" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Fundo"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="17"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fundo" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fundo" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fundo" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fundo" Property="BorderBrush" Value="{StaticResource PincelVerdeClaro}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Na faixa verde: botao branco com texto verde -->
    <Style TargetType="{x:Type Button}" x:Key="BotaoFaixa" BasedOn="{StaticResource BotaoPilula}" />

    <!-- Na faixa verde: so o contorno branco -->
    <Style TargetType="{x:Type Button}" x:Key="BotaoFaixaContorno" BasedOn="{StaticResource BotaoPilula}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Sobre fundo branco ou cinza: contorno verde -->
    <Style TargetType="{x:Type Button}" x:Key="BotaoContorno" BasedOn="{StaticResource BotaoPilula}">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource PincelVerdeEscuro}" />
        <Setter Property="BorderBrush" Value="{StaticResource PincelVerdeClaro}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>

    <!-- No console grafite -->
    <Style TargetType="{x:Type Button}" x:Key="BotaoConsole" BasedOn="{StaticResource BotaoPilula}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#AAAAAA" />
        <Setter Property="BorderBrush" Value="#555555" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- Rotulo pequeno em maiusculas da coluna Minha maquina -->
    <Style TargetType="{x:Type TextBlock}" x:Key="RotuloInfo">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource PincelTextoSuave}" />
        <Setter Property="Margin" Value="0,8,0,1" />
    </Style>

    <!-- Titulo de cada bloco da coluna Minha maquina (Computador, Placa, Enderecos...) -->
    <Style TargetType="{x:Type TextBlock}" x:Key="TituloGrupo">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="{StaticResource PincelVerde}" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <!-- Celula da tabela de hosts: o texto inteiro aparece na dica, porque a celula corta sem reticencias -->
    <Style TargetType="{x:Type TextBlock}" x:Key="CelulaComDica">
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="ToolTip" Value="{x:Null}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TextBlock}" x:Key="ValorInfo">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Tabela de hosts -->
    <Style TargetType="{x:Type DataGrid}" x:Key="TabelaHosts">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="CanUserSortColumns" Value="True" />
        <Setter Property="SelectionMode" Value="Extended" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource PincelBorda}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="RowBackground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowHeight" Value="28" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>

    <Style TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource PincelTextoSuave}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderBrush" Value="{StaticResource PincelBorda}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style TargetType="{x:Type DataGridCell}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridCell}">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource PincelVerdeFundo}" />
                <Setter Property="Foreground" Value="{StaticResource PincelTexto}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Marca da MT na barra de estado: sem fundo nem borda, so o conteudo e a mao no mouse -->
    <Style TargetType="{x:Type Button}" x:Key="BotaoMarca">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Fundo" Background="{TemplateBinding Background}" Padding="2">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fundo" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <BooleanToVisibilityConverter x:Key="VisivelSe" />

    <!-- Abas do console: a escolhida fica grafite com texto verde-claro, as outras em cinza -->
    <Style TargetType="{x:Type ListBox}" x:Key="AbasConsole">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding Titulo}" ToolTip="{Binding Descricao}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="11.5" />
                    <Setter Property="Foreground" Value="#9A9A9A" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <Border x:Name="Fundo" Background="Transparent" CornerRadius="6,6,0,0" Padding="12,5" Margin="0,0,2,0">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Fundo" Property="Background" Value="{StaticResource PincelGrafite}" />
                                        <Setter Property="Foreground" Value="{StaticResource PincelVerdeClaro}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#E6E6E6" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TextBlock}" x:Key="RotuloConsole">
        <Setter Property="Foreground" Value="#CFCFCF" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <Style TargetType="{x:Type TextBox}" x:Key="CampoConsole">
        <Setter Property="Background" Value="#2E2E2E" />
        <Setter Property="Foreground" Value="#F0F0F0" />
        <Setter Property="CaretBrush" Value="#F0F0F0" />
        <Setter Property="BorderBrush" Value="#555555" />
        <Setter Property="FontFamily" Value="{StaticResource FonteConsole}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="5,3" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Executar das ferramentas: pilula verde-clara sobre o grafite -->
    <Style TargetType="{x:Type Button}" x:Key="BotaoExecutar" BasedOn="{StaticResource BotaoPilula}">
        <Setter Property="Background" Value="{StaticResource PincelVerdeClaro}" />
        <Setter Property="Foreground" Value="{StaticResource PincelGrafite}" />
        <Setter Property="BorderBrush" Value="{StaticResource PincelVerdeClaro}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,3" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>

    <!-- Barra de progresso verde -->
    <Style TargetType="{x:Type ProgressBar}" x:Key="ProgressoMT">
        <Setter Property="Height" Value="8" />
        <Setter Property="Width" Value="160" />
        <Setter Property="Foreground" Value="{StaticResource PincelVerdeClaro}" />
        <Setter Property="Background" Value="#3A3A3A" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Texto da barra de estado -->
    <Style TargetType="{x:Type TextBlock}" x:Key="TextoEstado">
        <Setter Property="Foreground" Value="#E6E6E6" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,18,0" />
        <!-- Sem corte com reticencias: o WPF usaria o caractere unico, proibido nos textos da MT -->
        <Setter Property="TextTrimming" Value="None" />
    </Style>
</ResourceDictionary>
