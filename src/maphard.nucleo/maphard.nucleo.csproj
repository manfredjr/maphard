<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>maphard.nucleo</AssemblyName>
    <RootNamespace>MapHard.Nucleo</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Nucleo do MapHard - MT: leitura do hardware, interpretacao, coleta e relatorios.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="maphard.testes" />
  </ItemGroup>

  <!-- A licença vai dentro do programa, para a janela Sobre mostrá-la sem internet -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="licenca.txt" />
    <EmbeddedResource Include="tabelas\processadores.csv" LogicalName="processadores.csv" />
    <EmbeddedResource Include="tabelas\fabricantes-memoria.csv" LogicalName="fabricantes-memoria.csv" />
    <EmbeddedResource Include="tabelas\atributos-smart.csv" LogicalName="atributos-smart.csv" />
    <EmbeddedResource Include="tabelas\problemas-dispositivo.csv" LogicalName="problemas-dispositivo.csv" />
    <EmbeddedResource Include="tabelas\chipsets.csv" LogicalName="chipsets.csv" />
    <EmbeddedResource Include="tabelas\fabricantes-pci.csv" LogicalName="fabricantes-pci.csv" />
    <EmbeddedResource Include="tabelas\processadores-windows11.csv" LogicalName="processadores-windows11.csv" />
  </ItemGroup>

</Project>
